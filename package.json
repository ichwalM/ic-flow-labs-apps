{
  "name": "ic-flow-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "corepack pnpm --filter @flowlab/web dev",
    "build": "corepack pnpm --filter @flowlab/web build",
    "start": "corepack pnpm --filter @flowlab/web start",
    "lint": "eslint .",
    "typecheck": "corepack pnpm --filter @flowlab/web typecheck && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.56.0",
    "vitest": "^4.0.0"
  }
}
